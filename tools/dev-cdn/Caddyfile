# The development CDN.
#
# It is a static file server, because that is what a CDN is. The URL shape a build is served
# at -- /game/<build-id>/... -- is a directory layout and needs no routing.
#
# What this file is really for is the headers. Every one below is something the real CDN must
# also be told to do, and something that breaks quietly if it is not:
#
#   - `Content-Type: application/wasm` or the browser refuses to stream-compile, silently
#     falling back to the slow path.
#   - Pre-compressed `.br` served with `Content-Encoding: br` and the *original* content type.
#     Getting the type from the `.br` extension instead is the classic way to break this.
#   - CORS, because the page and its assets are different origins by construction.
#   - `immutable`, because nothing here is ever overwritten -- a new build is a new directory.
#
# Treat this as the specification to hand to R2 or Bunny later, not as a toy.

{
	admin off
	auto_https off
}

:3101 {
	root * /srv/cdn

	# In production this is the site's origin, not a wildcard. Set CDN_ALLOW_ORIGIN to
	# rehearse that; the default is open because a dev CDN serves several local origins.
	header {
		Access-Control-Allow-Origin "{$CDN_ALLOW_ORIGIN:*}"
		Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		Cache-Control "public, max-age=31536000, immutable"
		-Server
	}

	# Caddy's MIME table does not know these three, and a wrong type on the first one costs
	# streaming compilation.
	@wasm path *.wasm
	header @wasm Content-Type "application/wasm"
	@wgsl path *.wgsl
	header @wgsl Content-Type "text/plain; charset=utf-8"
	@sky path *.lcsky
	header @sky Content-Type "application/octet-stream"
	# The shelf. Under `library/` rather than `game/<build-id>/`, because a book is not part of
	# a build: see lightcone/docs/21-library.md.
	@epub path *.epub
	header @epub Content-Type "application/epub+zip"

	# A build directory that does not exist is a 404, not a fallback to anything. A CDN that
	# guesses is a CDN that serves last week's client to half the players.
	file_server {
		precompressed br gzip
		hide .git
	}

	log {
		output stdout
		format console
	}
}

# What the CDN holds, for the administration console. **Internal only**: never published with
# `-p` and never proxied, because this is the one port that lists — the public side above
# answers a directory with a 404. Docker's published ports bypass the host firewall, so "just
# for debugging" puts the listing on the LAN; `-p 127.0.0.1:3103:3103` if it must be reached
# from the host at all.
#
# The stand-in for a bucket's list API (S3 `ListObjectsV2`), which takes a credential too;
# see lightcone/docs/14-hosting.md. JSON when asked with `Accept: application/json`.
#
# Unset, the default is the hash of random bytes nobody kept, so the port refuses everyone. It
# has to be a valid hash: Caddy refuses to start on a malformed one, public port included.
:3103 {
	root * /srv/cdn
	basic_auth {
		console {$CDN_LIST_HASH:$2a$14$dP5PV73tuT8mC9kfteb1F.qAIegwpRVLKF0q/zNCzQ8OQvqYEC.xe}
	}
	file_server browse {
		hide .git
	}
}
