# Every setting deploy/compose.yaml reads, as `~/.config/lightcone/lightcone.env` on the host.
# Mode 600. Values never leave the host; generate secrets there:
#
#   head -c 32 /dev/urandom | base64 | tr -d '\n=' | tr '+/' '-_'
#
# A value containing `$` (CDN_LIST_HASH) goes in single quotes, or compose expands it.

# The development stack's parent name: the site is here, the rest are subdomains of it.
LC_DOMAIN=dev.lightconefrontier.com
SHARD_AUDIENCE=shard-1
# The galaxy's manifest under the CDN root, as tools/publish-galaxy.sh prints it.
SKY_PATH=galaxy/phase-2/<hash>.galaxy

# The database server.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# The site's database, the broker's (which the console shares), and the shard's as a libpq
# key=value string.
SITE_DATABASE_URL=
IDENTITY_DATABASE_URL=
LC_SHARD_DB=

# The broker. The exchange secret is the site's LC_IDENTITY_SECRET and the console's
# LC_ADMIN_IDENTITY_SECRET too. The signing seed must not change, or every ticket stops
# verifying.
LC_IDENTITY_PROVIDERS=
IDENTITY_EXCHANGE_SECRET=
LC_IDENTITY_SIGNING_SEED=

# The site. RELEASE_TOKEN registers and promotes builds; RELEASE_READ_TOKEN only lists them,
# and the console uses it.
SITE_SESSION_KEY=
RELEASE_TOKEN=
RELEASE_READ_TOKEN=
FALLBACK_BUILD_ID=

# The console's own cookie key, at least 32 characters.
ADMIN_SESSION_KEY=

# The CDN's listing port, which only the console reads: the password, and its bcrypt hash from
# `caddy hash-password`.
CDN_LIST_PASSWORD=
CDN_LIST_HASH=''

# The proxy's certificates, over Namecheap DNS-01. See the runbook's TLS section.
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
ACME_EMAIL=
NAMECHEAP_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_CLIENT_IP=
