# The administration console. Built on the `rocinante` context, from the same `auth` build
# context the broker uses, because the two share a cargo workspace and a lockfile.
#
#   docker --context rocinante build -f auth/Dockerfile.admin -t lightcone-admin:<tag> auth
#
# Two toolchains, and that is the whole reason this file is not the broker's. The console has a
# small TypeScript module; it is compiled here, by `tsc` for the types and `esbuild` for the
# bundle, in a stage of its own. Nothing about the Rust build knows that node exists.

FROM node:22-slim AS ui
WORKDIR /ui
# The manifests alone first, so a change to a `.ts` file does not reinstall node_modules.
COPY lc-admin/package.json lc-admin/package-lock.json ./
RUN npm ci
COPY lc-admin/tsconfig.json ./
COPY lc-admin/ts ./ts
# The vendored htmx, so `check:vendor` below has something to compare against.
COPY lc-admin/static/vendor ./static/vendor
# `npm run build` is three things, and each of them is a way for this image to fail rather
# than for a browser to: `tsc --noEmit` catches a type error, `check:vendor` catches a
# committed htmx that is not the one `package-lock.json` pins, and `esbuild` bundles.
RUN npm run build

FROM rust:1-bookworm AS chef
WORKDIR /build
RUN cargo install cargo-chef --locked

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /build/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json
COPY . .
RUN cargo build --release --bin lc-admin

FROM gcr.io/distroless/cc-debian12
WORKDIR /app
COPY --from=builder /build/target/release/lc-admin /app/lc-admin
# Unlike the broker, this image ships a `static/` tree. The stylesheet is compiled at boot
# beside a script that was compiled by a different toolchain in a different stage — see
# `lc_admin::assets` for why one answer to "where do assets come from" is worth the read.
COPY lc-admin/static /app/static
COPY --from=ui /ui/static/js/admin.js /app/static/js/admin.js
# **htmx comes from the lockfile, not from the committed copy.** Both are checked to be the
# same bytes by the stage above, so this is belt and braces rather than a second source of
# truth — but it is the belt that makes "the image ships what package-lock.json pins" true by
# construction instead of by somebody having remembered to run `npm run vendor`.
COPY --from=ui /ui/node_modules/htmx.org/dist/htmx.min.js /app/static/vendor/htmx.min.js
# **No migrations.** `lc-identity` owns the schema and applies it at its own boot; this
# service reads and writes tables it did not create. See `lc_admin`'s crate documentation.
ENV BIND_ADDR=0.0.0.0:3300
ENV LC_ADMIN_STATIC_DIR=/app/static
EXPOSE 3300
USER nonroot
ENTRYPOINT ["/app/lc-admin"]
