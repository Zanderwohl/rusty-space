    metadata: FileMetadata(
        name: "engine flank hull",
        description: Some("Engine, off its open faces: greebled machinery. Housings, louvered recesses and small fittings on grids at co-prime pitches, pipe runs along v, and plating seams every 8 m. Nothing lit. One tile is 64 m of hull and must repeat: integer frequencies, and noise with period == frequency. Output color is albedo; the layer named lights is the lit share of each texel. See em_render::hull_material."),
        authors: [
            "Alexander Lowry",
        ],
