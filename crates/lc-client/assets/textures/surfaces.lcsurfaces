# Which texture graphs draw a resolved body's surface. TOML.
#
# A body takes its class's graph, which is the pattern only, in [0, 1]: the palette and contrast
# stay the class's, from lc_world::surface. A body named under [bodies] takes that graph instead,
# and its color output is the surface's color. One named under [clouds] has a deck drawn over the
# surface from that graph's "zonal" (weather) and "drive term 1" (climate) layers; the shader
# does the rest, and surfaces.rs's tests hold it to the graph's output. Paths are under
# textures/, and each body's seed is its name's.
#
# A rocky world with air -- anything lc_world::climate gives a climate, measured or generated --
# takes the [rocky] graphs, with the ground graph's parameters bound from that climate. Earth and
# Mars are two settings of it. A body named under [bodies] still takes its own graph over that.
#
# A giant takes the [giants] graph the same way, with its parameters bound from lc_world::giant:
# its bands from how fast it turns, its colors from what its cloud tops are made of.
#
# Surfaces are baked on a sphere, so a graph here may use only Color, Noise, Coordinate, Mix,
# MinMax and Wave; Map, with a palette of any kind; and a passthrough Transform set to Extend.

[classes]
GasGiant = "surfaces/gas_giant.tgraph"
IceGiant = "surfaces/ice_giant.tgraph"
Ice = "surfaces/ice.tgraph"
Rock = "surfaces/rock.tgraph"
Weathered = "surfaces/weathered.tgraph"
Scorched = "surfaces/scorched.tgraph"

[rocky]
ground = "worlds/rocky.tgraph"
clouds = "worlds/earthlike-clouds.tgraph"

[giants]
graph = "worlds/giant.tgraph"
